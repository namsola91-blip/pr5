# Local PostgreSQL connection. Replace the password with your own value.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=change_me
PGDATABASE=pr5_contacts

# Matches the Angular development proxy in proxy.conf.json.
PORT=8081

# For hosted PostgreSQL with SSL, use DATABASE_URL instead of PG* variables.
# Never commit real credentials.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
